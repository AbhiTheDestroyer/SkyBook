# SkyBook production environment template.
# Copy to .env on the server. NEVER commit real values.

# --- Required ---------------------------------------------------------------
NODE_ENV=production
ENABLE_DEV_SESSIONS=false
PORT=3001

# SQLite location. Point at a mounted persistent volume or data is lost on redeploy.
SKYBOOK_DB_PATH=/data/skybook.db

# Bootstrap admin password. If unset, a RANDOM password is generated and you
# cannot log in. Sets the password for admin@skybook.demo (legacy role
# AIRLINE_ADMIN, which the RBAC layer maps to ADMIN).
SKYBOOK_ADMIN_PASSWORD=replace_with_a_long_random_value

# Strips the published demo-account passwords (they keep working as data, but
# become unguessable). Set "false" on ANY host the public can reach.
SKYBOOK_DEMO_USERS=false

# Number of trusted reverse-proxy hops. 1 = Caddy/Render/Fly in front of the app.
# Without this, login rate limiting would see the proxy IP for every visitor and
# could lock all users out together. Set to 0 if the app is exposed directly.
TRUST_PROXY=1

# --- Cross-origin -----------------------------------------------------------
# Only needed if the frontend is served from a different host than the API.
# Comma-separated. Leave blank when served same-origin (the default here).
CORS_ORIGIN=

# --- Real flight inventory --------------------------------------------------
# Without these, /api/health reports DEMO_DYNAMIC and flights are generated
# demo data — not bookable real-world inventory.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Payments (Razorpay) ----------------------------------------------------
# Without these, checkout is disabled and fails closed. It does NOT fake success.
PAYMENT_PROVIDER=razorpay
PAYMENT_ENVIRONMENT=test
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Web push ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional AI ------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Booking calendar -------------------------------------------------------
MIN_ADVANCE_BOOKING_DAYS=0
MAX_ADVANCE_BOOKING_DAYS=365
BOOKING_TIMEZONE=Asia/Kolkata
