# Amadeus Self-Service API credentials — keep server-side only.
# Get sandbox credentials at https://developers.amadeus.com/
AMADEUS_API_KEY=your_api_key
AMADEUS_API_SECRET=your_api_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional OpenAI-compatible model for natural free-form Sky Assist responses.
# The backend grounds prompts with SkyBook data and falls back safely when unavailable.
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Development bootstrap only. Required to create a known development administrator.
# Never commit a real value. Production should provision admins through a secure setup process.
SKYBOOK_ADMIN_PASSWORD=
ENABLE_DEV_SESSIONS=false
